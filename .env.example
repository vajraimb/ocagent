# Copy of the variables the deployment needs for Gmail sending.
# DO NOT copy this file to `.env` in the workspace and never commit real values:
# set them as environment variables / secrets in the deployment (Vercel →
# Project → Settings → Environment Variables). See README "Sending email
# through Gmail" for how to obtain each one.

# OAuth 2.0 client of type "Desktop app" from Google Cloud Console → APIs &
# Services → Credentials (Gmail API must be enabled on the same project).
GMAIL_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-replace-me

# Minted once with `node scripts/gmail-oauth-token.mjs` while signed in as the
# sending account. Scope: https://www.googleapis.com/auth/gmail.send only.
GMAIL_REFRESH_TOKEN=1//0replace-me

# The Gmail address that approved the consent screen; used as the From header.
GMAIL_SENDER=shunjie.bi@gmail.com

# Shared secret for `POST /api/mail/send` (Authorization: Bearer <token>).
# At least 24 characters, e.g. `openssl rand -hex 32`. Leave unset to keep the
# HTTP endpoint disabled (server-side `sendGmail()` still works).
OCAGENT_MAIL_TOKEN=replace-with-a-long-random-string
